# GEMINI_API_KEY: Required for Gemini AI API calls (BuildSmart Assistant & AI Inspector).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_GOOGLE_MAPS_API_KEY: Provisioned for Google Maps JavaScript API (Pune Construction Site Map).
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# SUPABASE INTEGRATION (Optional - app defaults to reactive local persistence with full seed data)
VITE_SUPABASE_URL="https://xyzcompany.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

